{
  "name": "typedoc-vite",
  "version": "0.0.1",
  "description": "A Vite plugin that generates TypeDoc documentation with HMR.",
  "keywords": [
    "typedoc",
    "vite"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "release": "pnpm build && pnpm publish"
  },
  "dependencies": {
    "typedoc": "^0.28.16"
  },
  "devDependencies": {
    "tsdown": "^0.18.0",
    "vite": "^8.0.13"
  },
  "packageManager": "pnpm@10.33.0"
}
